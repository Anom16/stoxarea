.sv-autocomplete{position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e0e0e0;border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.1);z-index:9999;max-height:400px;overflow-y:auto;display:none}
.sv-autocomplete.active{display:block}
.sv-ac-item{display:flex;align-items:center;padding:8px 12px;text-decoration:none;color:#333;font-size:.87rem;border-bottom:1px solid #f5f5f5}
.sv-ac-item:hover,.sv-ac-item.selected{background:#f0fdf4}
