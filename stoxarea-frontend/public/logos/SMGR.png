</style>
<div class="sv-autocomplete" id="sv-ac"></div>
<script type="460b29b8af16844d187f4434-text/javascript">
(function(){
var timer,ac=document.getElementById('sv-ac'),inputs=document.querySelectorAll('#nav-domain-desktop,#nav-domain-mobile');
inputs.forEach(function(inp){
inp.addEventListener('input',function(){
clearTimeout(timer);var q=this.value.trim();
if(q.length<2){ac.classList.remove('active');return}
timer=setTimeout(function(){
fetch('/api/search?q='+encodeURIComponent(q)).then(r=>r.json()).then(function(d){
if(!d.results.length){ac.classList.remove('active');return}
ac.innerHTML=d.results.map(function(r){
return '<a class="sv-ac-item" href="'+r.url+'"><span class="type">'+r.type+'</span><span class="label">'+r.label+'</span><span class="meta">'+r.meta+'</span></a>'
}).join('');
ac.classList.add('active');
});
},200);
});
inp.addEventListener('blur',function(){setTimeout(function(){ac.classList.remove('active')},200)});
inp.addEventListener('focus',function(){if(ac.innerHTML&&this.value.length>=2)ac.classList.add('active')});
});
document.addEventListener('click',function(e){if(!ac.contains(e.target))ac.classList.remove('active')});
})();
</script>

