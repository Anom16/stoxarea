# ============================================
# STOXAREA BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update values
# NEVER commit .env to git!

# Database
DATABASE_URL=sqlite:///./stoxarea.db
# For PostgreSQL: postgresql://user:password@localhost:5432/stoxarea

# Security - REQUIRED in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-me-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Feature flags
RATE_LIMIT_ENABLED=true

# ML Pipeline
# AI_SCORES_PATH=data/processed/ai_scores.json
# CAPPING_BOUNDS_PATH=data/processed/capping_bounds.json
# MODEL_PATH=ml/models_saved/xgb_model.pkl
